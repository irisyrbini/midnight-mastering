# Local model library is large; only the game-referenced generic .glb files are committed (the rest —
# raw Meshy exports, unused takes, alternate character sets — stay local until wired in).
public/models/*
!public/models/idle.glb
!public/models/walking.glb
!public/models/running.glb
!public/models/sit.glb
!public/models/lie.glb
!public/models/scroll.glb
# Player interaction poses (FBX — the usable, Armature-bound versions of make-tune / drink / doomscroll).
!public/models/maketune.fbx
!public/models/drink.fbx
!public/models/scroll.fbx
!public/models/shadow
!public/models/bigfreq
public/models/shadow/*
public/models/bigfreq/*
!public/models/shadow/walk.glb
!public/models/shadow/sit.glb
!public/models/shadow/idle.glb
# NPC2 (Tom = redesigned "Urban Shadow Figure") is now FBX: mesh/idle + walk clip + its textures.
!public/models/bigfreq/idle.fbx
!public/models/bigfreq/Meshy_AI_Urban_Shadow_Figure_biped_Animation_Walking_withSkin.fbx
!public/models/bigfreq/Meshy_AI_Urban_Shadow_Figure_biped_texture_0.png
!public/models/bigfreq/Meshy_AI_Urban_Shadow_Figure_biped_texture_0_normal.png
